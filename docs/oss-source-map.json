{
  "repository": "nuxtjp/site-builder",
  "purpose": "Build Japanese/English product and organization sites from validated declarative content.",
  "responsibility_boundary": "Organizations own claims, links, release/download data attribution and deployment. A site preview or source merge is not production acceptance.",
  "packages": [
    {
      "manifest": "package.json",
      "package": "@nuxtjp/localized-site",
      "ecosystem": "npm",
      "description": "Contract-first Japanese and English public-site module for Nuxt",
      "interfaces": {
        "exports": {
          ".": {
            "types": "./dist/types.d.mts",
            "import": "./dist/module.mjs"
          },
          "./core": {
            "types": "./dist/runtime/core/index.d.ts",
            "import": "./dist/runtime/core/index.js"
          },
          "./validator": {
            "types": "./validator/content/index.d.ts",
            "import": "./validator/content/index.js"
          },
          "./schema": "./schemas/localized-site-v1.schema.json",
          "./organization": {
            "types": "./organization/index.d.mts",
            "import": "./organization/index.mjs"
          },
          "./showcase": {
            "types": "./validator/showcase/index.d.ts",
            "import": "./validator/showcase/index.js"
          },
          "./showcase/collectors": {
            "types": "./validator/showcase/collectors.d.ts",
            "import": "./validator/showcase/collectors.js"
          },
          "./consent": {
            "types": "./dist/runtime/consent/module.d.ts",
            "import": "./dist/runtime/consent/module.js"
          },
          "./consent/schema": "./schemas/consent-v1.schema.json",
          "./documents": {
            "types": "./documents/index.d.mts",
            "import": "./documents/index.mjs"
          }
        },
        "bin": {
          "nuxtjp-localized-site": "./bin/nuxtjp-localized-site.mjs"
        },
        "main": "./dist/module.mjs",
        "types": "./dist/types.d.mts"
      },
      "declared_commands": {
        "build:module": "nuxt-module-build build",
        "build:validator": "tsc -p tsconfig.validator.json",
        "build": "pnpm run build:security && pnpm run build:validator && pnpm run build:module && nuxt build playground",
        "typecheck": "vue-tsc --noEmit --project tsconfig.json",
        "test": "vitest run && pnpm run test:organization && pnpm run test:dependency-security && pnpm run test:consumer-security && pnpm test:site-template && pnpm test:documents",
        "validate:example": "node ./bin/nuxtjp-localized-site.mjs validate --content-root ./examples/content",
        "prepack": "pnpm test && pnpm typecheck && pnpm build && pnpm validate:example",
        "test:organization": "pnpm run build:validator && pnpm run build:module && node --test test/organization-check.mjs",
        "test:dependency-security": "node security/dependency-security.check.cjs",
        "test:consumer-security": "node --test scripts/consumer-security.check.mts",
        "test:site-template": "node --test scripts/service-template.check.mjs",
        "build:security": "tsc -p tsconfig.security.json",
        "test:consent:browser": "node test/run-consent-browser.mjs",
        "test:documents": "node --test scripts/documents.check.mjs"
      }
    }
  ],
  "schema_definitions": [
    "schemas/localized-site-v1.schema.json",
    "schemas/public-maintenance-state-v1.schema.json"
  ],
  "test_sources": [
    "organization/workspace.mjs",
    "scripts/check-public-package.py",
    "scripts/consumer-security.check.mts",
    "security/project.mjs",
    "src/runtime/core/path.ts",
    "src/runtime/core/seo.ts",
    "test/cli.test.ts",
    "test/contract.test.ts",
    "test/fixture.ts",
    "test/maintenance.test.ts",
    "test/messages.test.ts",
    "test/organization-check.mjs",
    "test/path.test.ts",
    "test/seo.test.ts",
    "test/showcase-collectors.test.ts",
    "test/showcase.test.ts",
    "scripts/documents.check.mjs",
    "scripts/service-template.check.mjs"
  ],
  "example_sources": [
    "examples/content/site.config.json",
    "playground/app.vue",
    "playground/data/showcase.json",
    "playground/nuxt.config.ts",
    "playground/pages/oss/[id].vue",
    "playground/pages/oss/index.vue"
  ],
  "workflow_definitions": [
    {
      "path": ".github/workflows/oss-policy.yml",
      "jobs": [
        {
          "job": "repository-policy",
          "condition": null,
          "runs_on": "ubuntu-latest",
          "steps": [
            {
              "name": null,
              "run": null,
              "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
              "condition": null
            },
            {
              "name": "Verify repository policy",
              "run": "python3 .github/oss-policy-check.py",
              "uses": null,
              "condition": null
            },
            {
              "name": "Verify policy regression tests",
              "run": "cd .github && python3 -m unittest discover -s policy-tests",
              "uses": null,
              "condition": null
            },
            {
              "name": "Reject retired publication modes",
              "run": "python3 .github/scripts/test_release_plan.py",
              "uses": null,
              "condition": null
            },
            {
              "name": "Check policy types",
              "run": "python3 -m venv \"$RUNNER_TEMP/policy-types\"\n\"$RUNNER_TEMP/policy-types/bin/pip\" install -r .github/policy/requirements.txt\n\"$RUNNER_TEMP/policy-types/bin/mypy\" --strict .github/policy .github/oss-policy-check.py .github/policy-tests\n",
              "uses": null,
              "condition": null
            }
          ]
        }
      ]
    },
    {
      "path": ".github/workflows/publish-npm.yml",
      "jobs": [
        {
          "job": "contract",
          "condition": null,
          "runs_on": "ubuntu-24.04",
          "steps": [
            {
              "name": null,
              "run": null,
              "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
              "condition": null
