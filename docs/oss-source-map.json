            {
              "name": null,
              "run": null,
              "uses": "actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9",
              "condition": null
            }
          ]
        },
        {
          "job": "publish",
          "condition": "vars.REGISTRY_PUBLISH_ENABLED == 'true'",
          "runs_on": "ubuntu-24.04",
          "steps": [
            {
              "name": null,
              "run": null,
              "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
              "condition": null
            },
            {
              "name": null,
              "run": null,
              "uses": "actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1",
              "condition": null
            },
            {
              "name": null,
              "run": "npm install --global --ignore-scripts npm@12.2.0",
              "uses": null,
              "condition": null
            },
            {
              "name": null,
              "run": null,
              "uses": "actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333",
              "condition": null
            },
            {
              "name": "Verify the exact prepared archive",
              "run": "python3 .github/scripts/archive_binding.py verify npm \"$RUNNER_TEMP/npm-release\"",
              "uses": null,
              "condition": null
            },
            {
              "name": "Publish through the repository Trusted Publisher",
              "run": "set -euo pipefail\nif test \"$PUBLICATION_MODE\" = direct; then\n  npm publish \"$RUNNER_TEMP/npm-release/$ARCHIVE_NAME\" --access public --provenance --ignore-scripts --registry=https://registry.npmjs.org\n  python3 .github/scripts/archive_binding.py registry npm \"$RUNNER_TEMP/npm-release\"\nelif test -z \"$PUBLICATION_MODE\" || test \"$PUBLICATION_MODE\" = stage; then\n  npm stage publish \"$RUNNER_TEMP/npm-release/$ARCHIVE_NAME\" --access public --provenance --ignore-scripts --json --registry=https://registry.npmjs.org > \"$RUNNER_TEMP/npm-stage-response.json\"\n  python3 .github/scripts/stage_notification.py \"$RUNNER_TEMP/npm-release\" \"$RUNNER_TEMP/npm-stage-response.json\"\n  rm -f \"$RUNNER_TEMP/npm-stage-response.json\"\nelse\n  echo 'Unknown NPM_PUBLICATION_MODE'; exit 1\nfi\ncat \"$RUNNER_TEMP/npm-release/release-receipt.json\" >> \"$GITHUB_STEP_SUMMARY\"\n",
              "uses": null,
              "condition": null
            },
            {
              "name": null,
              "run": null,
              "uses": "actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9",
              "condition": "steps.publication.outputs.stage-id != ''"
            }
          ]
        },
        {
          "job": "notify",
          "condition": "needs.publish.outputs.stage-id != ''",
          "runs_on": "ubuntu-24.04",
          "steps": [
            {
              "name": null,
              "run": null,
              "uses": "actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333",
              "condition": null
            },
            {
              "name": "Notify the owner issue queue without npm credentials or approval authority",
              "run": "set -euo pipefail\ncount=$(gh issue list --repo \"$GITHUB_REPOSITORY\" --state all --search \"$STAGE_ID in:body\" --json number --jq 'length')\nif test \"$count\" = 0; then\n  gh issue create --repo \"$GITHUB_REPOSITORY\" --title \"[npm stage] Review $STAGE_ID\" --body-file \"$RUNNER_TEMP/npm-stage-notice/notice.md\"\nfi\ncat \"$RUNNER_TEMP/npm-stage-notice/notice.md\" >> \"$GITHUB_STEP_SUMMARY\"\n",
              "uses": null,
              "condition": null
            }
          ]
        }
      ]
    },
