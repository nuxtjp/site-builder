            },
            {
              "name": null,
              "run": "npm install --global --ignore-scripts npm@12.2.0 pnpm@10.29.3",
              "uses": null,
              "condition": null
            },
            {
              "name": "Build and pack the selected package without publication identity",
              "run": "set -euo pipefail\nif test -f \"$INSTALL_DIRECTORY/pnpm-lock.yaml\"; then\n  pnpm --dir \"$INSTALL_DIRECTORY\" install --frozen-lockfile --ignore-scripts\n  pnpm --dir \"$INSTALL_DIRECTORY\" -r --include-workspace-root --if-present run build\nelif test -f \"$INSTALL_DIRECTORY/package-lock.json\"; then\n  npm --prefix \"$INSTALL_DIRECTORY\" ci --ignore-scripts\n  npm --prefix \"$INSTALL_DIRECTORY\" run build --if-present\nelse\n  echo 'A committed dependency lock is required'; exit 1\nfi\ngit diff --exit-code\nmkdir -p \"$RUNNER_TEMP/npm-release\"\nnpm_config_ignore_scripts=true pnpm --dir \"$PACKAGE_DIRECTORY\" pack --pack-destination \"$RUNNER_TEMP/npm-release\"\n",
              "uses": null,
              "condition": null
            },
