{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nuxtjp:consent:definition:v1",
  "title": "Consent service definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyUrl",
    "policyRevision",
    "services"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "policyUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "maxLength": 2048
    },
    "policyRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "services": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/service"
      }
    },
    "defaultLocale": {
      "enum": [
        "ja",
        "en"
      ],
      "description": "Language for unprefixed URLs. Defaults to ja; explicit /ja and /en prefixes override it."
    }
  },
  "$defs": {
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "purpose",
        "category",
        "scripts",
        "cookies"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "category": {
          "enum": [
            "functional",
            "analytics",
            "marketing"
          ]
        },
        "scripts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/script"
          }
        },
        "cookies": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "maxLength": 128
          }
        }
      }
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "src"
      ],
      "properties": {
        "src": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "integrity": {
          "type": "string",
          "pattern": "^sha(256|384|512)-[A-Za-z0-9+/]+=*$"
        }
      }
    }
  }
}
